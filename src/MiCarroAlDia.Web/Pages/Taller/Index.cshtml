@page "/Taller"
@model MiCarroAlDia.Web.Pages.Taller.IndexModel
@{
    ViewData["Title"] = "Panel de Taller — Autofrenos del Norte";
}

<div class="container py-4">
    <!-- Header del Panel de Marcela -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fs-7 fw-semibold">
                    Operación Interna · Fase P1
                </span>
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-7">
                    Asesora: Marcela
                </span>
            </div>
            <h1 class="h2 fw-bold text-slate-900 mb-0">Panel de Gestión de Taller</h1>
            <p class="text-muted small mb-0">@Model.Dashboard.WorkshopName · Control de órdenes, avance de vehículos y cotizaciones adicionales.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Portal Clientes</span>
            </a>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#newOrderModal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="16"></line>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
                <span class="fw-semibold">Nueva Orden de Ingreso</span>
            </button>
        </div>
    </div>

    <!-- Tarjetas de Métricas del Taller -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <span class="text-muted small d-block mb-1">Órdenes en Taller</span>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="h3 fw-bold mb-0 text-slate-800">@Model.Dashboard.TotalActiveOrders</span>
                        <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <span class="text-muted small d-block mb-1">En Diagnóstico / Rep.</span>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="h3 fw-bold mb-0 text-warning">@Model.Dashboard.InProgressCount</span>
                        <div class="p-2 rounded-3 bg-warning-subtle text-warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <span class="text-muted small d-block mb-1">Esperando al Cliente</span>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="h3 fw-bold mb-0 text-info">@Model.Dashboard.PendingQuotesCount</span>
                        <div class="p-2 rounded-3 bg-info-subtle text-info">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <span class="text-muted small d-block mb-1">Listos / Entregados</span>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="h3 fw-bold mb-0 text-success">@Model.Dashboard.CompletedCount</span>
                        <div class="p-2 rounded-3 bg-success-subtle text-success">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Vehículos en Taller -->
    <h2 class="h5 fw-bold text-slate-800 mb-3 d-flex align-items-center gap-2">
        <span>Vehículos y Órdenes en Proceso</span>
        <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-7">@Model.Dashboard.Orders.Count</span>
    </h2>

    <div class="d-flex flex-column gap-3 mb-5">
        @foreach (var order in Model.Dashboard.Orders)
        {
            <div class="card border-0 shadow-sm overflow-hidden bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="row align-items-center g-3">
                        <!-- Identificación del Vehículo -->
                        <div class="col-12 col-md-4 col-lg-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-dark font-monospace px-2 py-1 fs-6">@order.VehiclePlate</span>
                                <span class="badge bg-light text-dark border small">Paso @order.CurrentStepNumber de 6</span>
                            </div>
                            <div class="fw-bold text-slate-900 fs-6">@order.VehicleModel</div>
                            <div class="text-muted small">Cliente: <span class="fw-medium text-slate-700">@order.CustomerName</span></div>
                        </div>

                        <!-- Barra de Avance y Estado -->
                        <div class="col-12 col-md-8 col-lg-5">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-slate-700">@order.CurrentStateName</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                    @((order.CurrentStepNumber * 100) / 6)%
                                </span>
                            </div>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                                     role="progressbar" 
                                     style="width: @((order.CurrentStepNumber * 100) / 6)%;" 
                                     aria-valuenow="@order.CurrentStepNumber" 
                                     aria-valuemin="1" 
                                     aria-valuemax="6">
                                </div>
                            </div>

                            @if (order.CanAdvanceProgress)
                            {
                                <form method="post" asp-page-handler="AdvanceProgress" class="d-flex gap-2">
                                    <input type="hidden" name="orderId" value="@order.WorkOrderId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 w-100 justify-content-center">
                                        <span>Avanzar a «@order.NextStateName»</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="13 17 18 12 13 7"></polyline>
                                            <polyline points="6 17 11 12 6 7"></polyline>
                                        </svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="small text-success fw-semibold d-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Vehículo entregado al cliente</span>
                                </div>
                            }
                        </div>

                        <!-- Estado de Cotización y Acciones -->
                        <div class="col-12 col-lg-4 border-top border-lg-0 pt-2 pt-lg-0">
                            <div class="bg-light p-3 rounded-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted fw-semibold">Cotización Adicional:</span>
                                    @if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Respondida)
                                    {
                                        <span class="badge bg-success text-white small">@order.QuoteStatusBadge</span>
                                    }
                                    else if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Vencida)
                                    {
                                        <span class="badge bg-danger text-white small">@order.QuoteStatusBadge</span>
                                    }
                                    else if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Pendiente)
                                    {
                                        <span class="badge bg-warning text-dark small">@order.QuoteStatusBadge</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary small">Sin cotización</span>
                                    }
                                </div>

                                @if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Respondida)
                                {
                                    <div class="small text-slate-800">
                                        <strong>Total autorizado:</strong> @order.TotalAuthorizedCop
                                    </div>
                                    <div class="small text-muted">
                                        (@order.ItemsApprovedCount aprobados · @order.ItemsRejectedCount rechazados)
                                    </div>
                                }
                                else if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Pendiente)
                                {
                                    <div class="small text-slate-800">
                                        <strong>Monto cotizado:</strong> @order.TotalProposedCop
                                    </div>
                                    <div class="small text-danger fw-semibold">
                                        ⏱️ @order.QuoteHoursRemainingText
                                    </div>
                                }
                                else if (order.QuoteStatus == MiCarroAlDia.Domain.Enums.QuoteStatus.Vencida)
                                {
                                    <div class="small text-danger fw-semibold">
                                        ⚠️ Cotización vencida (48h superadas).
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted mb-2">
                                        El vehículo no tiene cotizaciones pendientes.
                                    </div>
                                    <button type="button" class="btn btn-xs btn-outline-dark w-100 py-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#newQuoteModal" 
                                            data-order-id="@order.WorkOrderId"
                                            data-plate="@order.VehiclePlate">
                                        + Redactar Cotización
                                    </button>
                                }
                            </div>

                            <!-- Botones de Enlace WhatsApp y Vista Cliente -->
                            @if (!string.IsNullOrWhiteSpace(order.CustomerToken))
                            {
                                <div class="d-flex gap-2">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-success w-50 d-inline-flex align-items-center justify-content-center gap-1"
                                            onclick="copyToClipboard('/t/@order.CustomerToken')">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                        </svg>
                                        <span>Copiar Link</span>
                                    </button>
                                    <a href="/t/@order.CustomerToken" target="_blank" class="btn btn-sm btn-outline-secondary w-50 d-inline-flex align-items-center justify-content-center gap-1">
                                        <span>Ver Cliente</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                            <polyline points="15 3 21 3 21 9"></polyline>
                                            <line x1="10" y1="14" x2="21" y2="3"></line>
                                        </svg>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Nueva Orden de Trabajo -->
<div class="modal fade" id="newOrderModal" tabindex="-1" aria-labelledby="newOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CreateOrder">
                <div class="modal-header bg-slate-900 text-white">
                    <h5 class="modal-title fs-6 fw-bold" id="newOrderModalLabel">Registrar Nuevo Ingreso de Vehículo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Placa del Vehículo *</label>
                        <input type="text" name="vehiclePlate" class="form-control text-uppercase font-monospace" placeholder="Ej: ABC-123" required maxlength="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Marca, Línea y Modelo *</label>
                        <input type="text" name="vehicleModel" class="form-control" placeholder="Ej: Renault Sandero Stepway 2022" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Nombre Completo del Cliente *</label>
                        <input type="text" name="customerName" class="form-control" placeholder="Ej: Marcela Gómez" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Nota inicial de ingreso</label>
                        <textarea name="initialNote" class="form-control" rows="2" placeholder="Motivo de visita o reporte del cliente..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Crear Orden y Enlace WhatsApp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Redactar Cotización Adicional -->
<div class="modal fade" id="newQuoteModal" tabindex="-1" aria-labelledby="newQuoteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CreateQuote">
                <input type="hidden" id="modalOrderId" name="orderId" value="" />
                <div class="modal-header bg-slate-900 text-white">
                    <h5 class="modal-title fs-6 fw-bold" id="newQuoteModalLabel">Publicar Cotización Adicional</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Vehículo: <strong id="modalPlateLabel"></strong> · Esta cotización tendrá <strong>48 horas continuas</strong> de vigencia a partir de su publicación.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Descripción del Trabajo o Repuesto *</label>
                        <input type="text" name="description" class="form-control" placeholder="Ej: Cambio de pastillas de freno delanteras" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700">Tipo de Ítem</label>
                            <select name="type" class="form-select">
                                <option value="1">Repuesto</option>
                                <option value="2">Mano de Obra</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700">Categoría</label>
                            <select name="category" class="form-select">
                                <option value="1">Seguridad Crítica (Frenos/Suspensión)</option>
                                <option value="2">Mantenimiento General</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold text-slate-700">Cantidad</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" required />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-semibold text-slate-700">Precio Unitario Base (COP) *</label>
                            <input type="number" name="unitPrice" class="form-control" placeholder="Ej: 150000" min="1000" step="1000" required />
                            <span class="form-text small">El IVA del 19% se calculará automáticamente.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Publicar y Activar 48 Horas</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const quoteModal = document.getElementById('newQuoteModal');
    if (quoteModal) {
        quoteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const orderId = button.getAttribute('data-order-id');
            const plate = button.getAttribute('data-plate');
            document.getElementById('modalOrderId').value = orderId;
            document.getElementById('modalPlateLabel').textContent = plate;
        });
    }

    function copyToClipboard(text) {
        const fullUrl = window.location.origin + text;
        navigator.clipboard.writeText(fullUrl).then(() => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: '¡Enlace copiado!',
                    text: 'Enlace de WhatsApp listo para compartir: ' + fullUrl,
                    timer: 3000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            } else {
                alert('Enlace copiado: ' + fullUrl);
            }
        });
    }
</script>
}
