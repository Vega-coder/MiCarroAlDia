<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="/Index">
                    <span>🚗</span>
                    <span>Mi Carro al Día</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio y Escenarios</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Probar Escenarios
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Tracking/Index" asp-route-token="demo-activa">1. Cotización Activa (P0)</a></li>
                                <li><a class="dropdown-item" asp-page="/Tracking/Index" asp-route-token="demo-respondida">2. Respondida (Comprobante)</a></li>
                                <li><a class="dropdown-item" asp-page="/Tracking/Index" asp-route-token="demo-vencida">3. Vencida (&gt;48 horas)</a></li>
                                <li><a class="dropdown-item" asp-page="/Tracking/Index" asp-route-token="demo-sin-adicionales">4. Sin Adicionales (Listo)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Tracking/Index" asp-route-token="demo-taller-sur">5. Taller Sur (Multitenant)</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-white small gap-2">
                        <span>Autofrenos del Norte</span>
                        <a href="tel:+576044441234" class="btn btn-sm btn-outline-light">
                            📞 444-1234
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-3">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
