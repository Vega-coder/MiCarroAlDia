@page "{token?}"
@model MiCarroAlDia.Web.Pages.Tracking.IndexModel
@using MiCarroAlDia.Domain.Enums
@{
    ViewData["Title"] = Model.Tracking != null 
        ? $"Seguimiento {Model.Tracking.VehiclePlate} · MiCarroAlDía" 
        : "Consulta de Vehículo · MiCarroAlDía";
}

<div class="tracking-container">
    @if (Model.IsNotFound || Model.Tracking == null)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden my-4">
            <div class="p-4 bg-danger text-white d-flex align-items-center gap-3">
                <div class="rounded-circle bg-white text-danger p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div>
                    <h1 class="h5 fw-bold mb-0">Enlace no disponible o inválido</h1>
                    <small class="opacity-75">No se encontró información asociada a este token de acceso</small>
                </div>
            </div>
            <div class="card-body p-4">
                <p class="text-slate-600 mb-3">
                    Por seguridad y estricta privacidad de nuestros clientes, cada orden de servicio cuenta con una clave digital temporal única y encriptada.
                </p>
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <strong class="d-block text-slate-800 mb-1">¿Necesitas consultar el estado de tu vehículo?</strong>
                    <span class="text-slate-600 small d-block mb-3">
                        Comunícate con nuestro equipo de servicio para validar tu número de placa o solicitar un enlace actualizado por WhatsApp o mensaje directo.
                    </span>
                    <a href="tel:+576044441234" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>Contactar al Taller: (604) 444-1234</span>
                    </a>
                </div>
                <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
                    ← Volver al Panel de Demostración
                </a>
            </div>
        </div>
    }
    else
    {
        var t = Model.Tracking;
        var completedStepsCount = t.ProgressSteps.Count(s => s.IsCompleted);
        var totalStepsCount = t.ProgressSteps.Count;
        var progressPercentage = totalStepsCount > 0 ? (int)Math.Round((double)completedStepsCount / totalStepsCount * 100) : 0;
        var currentStepIndex = t.ProgressSteps.ToList().FindIndex(s => s.IsCurrent);
        if (currentStepIndex < 0) currentStepIndex = completedStepsCount - 1;

        <!-- Encabezado de Identificación del Vehículo y Taller -->
        <header class="app-header mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <span class="badge bg-slate-900 text-white text-uppercase px-2 py-1 fs-7 fw-bold letter-spacing-1">
                        Taller Autorizado
                    </span>
                    <h1 class="h4 mt-1 mb-0 text-slate-900 fw-bold">@t.WorkshopName</h1>
                    <p class="text-slate-500 mb-0 small">@t.WorkshopAddress · @t.WorkshopCity</p>
                </div>
                <div>
                    <a href="tel:@t.WorkshopPhone" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2 fw-semibold" title="Llamar al taller">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>@t.WorkshopPhone</span>
                    </a>
                </div>
            </div>

            <!-- Ficha del Vehículo Estilo Passport Automotriz -->
            <div class="vehicle-header-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="plate-badge" aria-label="Placa @t.VehiclePlate">
                            <span class="plate-country">COLOMBIA</span>
                            <strong class="plate-digits">@t.VehiclePlate</strong>
                            <span class="plate-city">@t.WorkshopCity</span>
                        </div>
                        <div>
                            <div class="vehicle-model-title">@t.VehicleModel</div>
                            <div class="customer-greeting">
                                <span>Titular:</span>
                                <strong>@t.CustomerName</strong>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="status-chip @(t.CurrentProgressState == VehicleProgressState.ListoParaEntregar ? "chip-ready" : "chip-progress")">
                            <span class="status-dot-pulse" style="background-color: @(t.CurrentProgressState == VehicleProgressState.ListoParaEntregar ? "#059669" : "#2563eb");"></span>
                            <span>@t.CurrentProgressStateName</span>
                        </span>
                    </div>
                </div>
            </div>
        </header>

        @if (TempData["SuccessFeedback"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-success shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <strong>Respuesta registrada con éxito:</strong>
                </div>
                <p class="mb-0 mt-1 small">@TempData["SuccessFeedback"]</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["InfoFeedback"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" role="alert">
                <p class="mb-0 small">@TempData["InfoFeedback"]</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <!-- Bloque 1: Stepper Visual Profesional de Avance -->
        <section class="stepper-progress-box mb-4" aria-labelledby="heading-progress">
            <div class="stepper-header">
                <div>
                    <span class="stepper-kicker">Etapa @(currentStepIndex + 1) de @totalStepsCount</span>
                    <h2 id="heading-progress" class="stepper-title">
                        Línea de Avance del Servicio
                    </h2>
                </div>
                <div>
                    <span class="stepper-metric-badge @(progressPercentage == 100 ? "ready" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>@progressPercentage% Completado</span>
                    </span>
                </div>
            </div>

            <!-- Línea de tiempo horizontal moderna -->
            <div class="stepper-pills-row" role="progressbar" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100">
                <div class="stepper-track-bg">
                    <div class="stepper-track-fill" style="width: @progressPercentage%;"></div>
                </div>
                @for (int idx = 0; idx < t.ProgressSteps.Count; idx++)
                {
                    var step = t.ProgressSteps[idx];
                    var nodeClass = step.IsCurrent ? "stepper-node current" : (step.IsCompleted ? "stepper-node completed" : "stepper-node pending");

                    <div class="@nodeClass">
                        <div class="stepper-node-circle" title="@step.Name">
                            @if (step.IsCompleted && !step.IsCurrent)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else if (step.IsCurrent)
                            {
                                <span class="fw-bold">@(idx + 1)</span>
                            }
                            else
                            {
                                <span class="fw-medium text-slate-400">@(idx + 1)</span>
                            }
                        </div>
                        <span class="stepper-node-label">@step.Name</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(t.CurrentProgressStateDescription))
            {
                <div class="technician-update-box">
                    <div class="technician-update-header">
                        <div class="technician-badge">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                            </svg>
                        </div>
                        <span>Actualización del Técnico de Servicio:</span>
                    </div>
                    <p class="technician-update-text">@t.CurrentProgressStateDescription</p>
                </div>
            }
        </section>

        <!-- Bloque 2: Estudio de Inspección 3D del Vehículo -->
        <section class="vehicle-3d-card mb-4" aria-labelledby="heading-3d">
            <div class="vehicle-3d-header">
                <div class="studio-title-box">
                    <div class="studio-indicator-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <div>
                        <h2 id="heading-3d" class="h6 mb-0 text-white fw-bold">
                            Inspección Técnica Digital 360°
                        </h2>
                        <small class="text-slate-400">@t.VehicleModel · Placa @t.VehiclePlate</small>
                    </div>
                </div>
                <div>
                    <span class="badge bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 fw-semibold">
                        Modo Taller Interactivo
                    </span>
                </div>
            </div>

            <!-- Contenedor del Lienzo Three.js con Overlay de Pines -->
            <div class="vehicle-3d-wrapper" id="vehicle3dContainer">
                <div class="touch-hint-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
                        <path d="M12 2a10 10 0 0 1 10 10"></path>
                    </svg>
                    <span>Arrastra para rotar · Pulsa los marcadores para inspeccionar</span>
                </div>
            </div>

            <!-- Barra de Herramientas de Inspección -->
            <div class="viewer-toolbar">
                <button type="button" class="btn-viewer-tool active" data-action="reset">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                    </svg>
                    <span>Giro Libre 360°</span>
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="brakes">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="4"></circle>
                        <line x1="12" y1="2" x2="12" y2="4"></line>
                        <line x1="12" y1="20" x2="12" y2="22"></line>
                    </svg>
                    <span>Frenos Delanteros</span>
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="wipers">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                    </svg>
                    <span>Limpiaparabrisas</span>
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="suspension">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v20M8 5h8M8 9h8M8 13h8M8 17h8"></path>
                    </svg>
                    <span>Suspensión</span>
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="engine">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                        <circle cx="12" cy="12" r="3"></circle>
                        <line x1="6" y1="12" x2="6.01" y2="12"></line>
                        <line x1="18" y1="12" x2="18.01" y2="12"></line>
                    </svg>
                    <span>Compartimiento Motor</span>
                </button>
                <button type="button" class="btn-viewer-tool" data-action="toggle-lift" id="btnToggleLift">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                    </svg>
                    <span>Elevador Hidráulico</span>
                </button>
            </div>

            <!-- Banner de Operación en Tiempo Real -->
            <div class="status-doing-banner">
                <div class="status-doing-badge">
                    <span class="status-dot-pulse" style="width: 6px; height: 6px; background-color: #60a5fa;"></span>
                    <span>Operación en Curso en Taller</span>
                </div>
                <p class="status-doing-text" id="statusDoingText">
                    @if (t.CurrentProgressState == VehicleProgressState.Diagnostico)
                    {
                        <span>
                            <strong>Inspección técnica en elevador:</strong> Vehículo posicionado en la bahía de diagnóstico. Medición de tolerancia de pastillas, espesor de discos y comprobación de tren delantero.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.Reparacion)
                    {
                        <span>
                            <strong>Reparación activa:</strong> Instalación de repuestos autorizados y ajuste con torquímetro según especificaciones del fabricante.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.ControlDeCalidad)
                    {
                        <span>
                            <strong>Control de calidad final:</strong> Prueba dinámica de frenado, alineación electrónica y revisión integral de seguridad antes de entrega.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.ListoParaEntregar)
                    {
                        <span>
                            <strong>Servicio finalizado:</strong> Todos los procedimientos culminaron satisfactoriamente. El vehículo se encuentra en zona de entrega.
                        </span>
                    }
                    else
                    {
                        <span>
                            <strong>Recepción e inventario:</strong> Ingreso registrado en sistema, asignación de bahía e inicio de hoja de vida de taller.
                        </span>
                    }
                </p>
            </div>
        </section>

        <!-- Bloque 3: Trabajos Adicionales Encontrados -->
        <section class="section-quotes mb-4" aria-labelledby="heading-quotes">
            <div class="section-quotes-header">
                <h2 id="heading-quotes" class="section-quotes-title">
                    Trabajos Adicionales Detectados
                </h2>
                @if (t.Quote != null)
                {
                    <span class="badge @(t.Quote.Status == QuoteStatus.Respondida ? "bg-success" : (t.Quote.Status == QuoteStatus.Vencida ? "bg-secondary" : "bg-warning text-dark")) px-3 py-2 fw-bold">
                        @t.Quote.StatusFriendlyName
                    </span>
                }
            </div>

            <div class="p-3 p-md-4">
                @if (!t.HasAdditionalQuote || t.Quote == null)
                {
                    <!-- Estado vacío amigable -->
                    <div class="text-center py-5">
                        <div class="mb-3 text-slate-400">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <polyline points="9 15 11 17 15 13"></polyline>
                            </svg>
                        </div>
                        <h3 class="h5 text-slate-800 fw-bold">No se registraron anomalías adicionales</h3>
                        <p class="text-slate-500 mb-0 small max-w-md mx-auto">
                            El equipo técnico continúa trabajando conforme a la orden principal acordada. Si surgiera alguna novedad en las pruebas, recibirás una notificación de inmediato.
                        </p>
                    </div>
                }
                else
                {
                    var q = t.Quote;

                    @if (q.Status == QuoteStatus.Respondida && q.Response != null)
                    {
                        <!-- ESTADO RESPONDIDO: Comprobante Definitivo -->
                        <div class="response-proof-box">
                            <div class="proof-stamp-header">
                                <div class="proof-stamp-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="proof-stamp-title">Comprobante de Respuesta Registrada</h3>
                                    <p class="proof-stamp-date">
                                        Registrado formalmente en el sistema de taller el <strong>@q.Response.SubmittedAtFormatted</strong>
                                    </p>
                                </div>
                            </div>

                            <div class="p-3 bg-light rounded-3 border mb-4">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="small text-slate-500">Total propuesto en diagnóstico:</div>
                                        <div class="fs-5 fw-bold text-slate-800">@q.TotalProposedAmountFormatted</div>
                                        <div class="small text-slate-400">(Base: @q.TotalProposedBaseFormatted · IVA 19%: @q.TotalProposedIvaFormatted)</div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="small text-primary fw-bold">Total de adicionales autorizados:</div>
                                        <div class="fs-4 fw-bold text-primary">@q.Response.TotalAuthorizedAmountFormatted</div>
                                        <div class="small text-slate-400">(Base: @q.Response.TotalAuthorizedBaseFormatted · IVA 19%: @q.Response.TotalAuthorizedIvaFormatted)</div>
                                    </div>
                                </div>
                            </div>

                            <h4 class="h6 fw-bold text-slate-800 mb-3">Detalle de autorizaciones ítem por ítem:</h4>
                            <div class="d-flex flex-column gap-3 mb-4">
                                @foreach (var item in q.Response.Items)
                                {
                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                    <span class="category-tag">@item.TypeName</span>
                                                    @if (item.IsSafetyCritical)
                                                    {
                                                        <span class="category-tag safety-tag">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                                            </svg>
                                                            <span>Seguridad Vial</span>
                                                        </span>
                                                    }
                                                    <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                                                            <circle cx="12" cy="12" r="3"></circle>
                                                        </svg>
                                                        <span>Ver en 3D</span>
                                                    </button>
                                                </div>
                                                <h5 class="h6 fw-bold mb-1 text-slate-900">@item.Description</h5>
                                                <div class="item-meta">
                                                    Cantidad: @item.Quantity × @item.UnitPriceFormatted (IVA 19% incl.)
                                                </div>
                                                @if (item.Decision == CustomerDecision.Rechazar && item.IsSafetyCritical && item.SecurityRejectionConfirmed)
                                                {
                                                    <div class="mt-2 text-danger small p-2 rounded bg-danger-subtle">
                                                        Rechazo de componente de seguridad confirmado expresamente por el titular.
                                                    </div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <div class="item-price-amount mb-2">@item.TotalAmountFormatted</div>
                                                @if (item.Decision == CustomerDecision.Aprobar)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold">
                                                        Aprobado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-bold">
                                                        Rechazado
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="alert alert-light border small text-slate-600 mb-0">
                                <strong>Nota de Seguridad del Taller:</strong> Esta autorización ha sido consolidada en el registro operativo del taller. Si deseas adicionar un trabajo complementario o revisar repuestos retirados, contacta a tu asesora asignada al <a href="tel:@t.WorkshopPhone" class="fw-bold">@t.WorkshopPhone</a>.
                            </div>
                        </div>
                    }
                    else if (q.Status == QuoteStatus.Vencida)
                    {
                        <!-- ESTADO VENCIDO (> 48 horas continuas) -->
                        <div class="expired-banner-box mb-4">
                            <div class="expired-header">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <h3 class="expired-title">El plazo de confirmación ha caducado (48 Horas)</h3>
                            </div>
                            <p class="text-slate-600 mb-2 small">
                                Esta cotización fue emitida el <strong>@q.PublishedAtFormatted</strong> y expiró el <strong>@q.ExpiresAtFormatted</strong>.
                            </p>
                            <p class="text-slate-600 mb-3 small">
                                Por disponibilidad de bahía y vigencia de precios de distribuidores de repuestos, el formulario digital se cierra automáticamente. Para reactivar o coordinar tu trabajo:
                            </p>
                            <div>
                                <a href="tel:@t.WorkshopPhone" class="btn btn-primary d-inline-flex align-items-center gap-2 fw-semibold px-4 py-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    <span>Llamar al Asesor de Taller: @t.WorkshopPhone</span>
                                </a>
                            </div>
                        </div>

                        <!-- Lista de ítems en modo solo lectura -->
                        <h4 class="h6 fw-bold mb-3 text-slate-700">Trabajos que fueron cotizados:</h4>
                        <div class="d-flex flex-column gap-2 mb-3 opacity-75">
                            @foreach (var item in q.Items)
                            {
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <span class="category-tag">@item.TypeName</span>
                                                @if (item.IsSafetyCritical)
                                                {
                                                    <span class="category-tag safety-tag">Seguridad Vial</span>
                                                }
                                                <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                    Ver en 3D
                                                </button>
                                            </div>
                                            <div class="fw-bold text-slate-800">@item.Description</div>
                                            <small class="text-slate-500">Cantidad: @item.Quantity | Base: @item.BaseAmountFormatted + IVA 19%: @item.IvaAmountFormatted</small>
                                        </div>
                                        <div class="item-price-amount">
                                            @item.TotalAmountFormatted
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- ESTADO PENDIENTE: Formulario Activo con Decisiones Ítem por Ítem -->
                        <div class="p-3 bg-slate-50 border rounded-3 mb-4 d-flex align-items-center gap-3">
                            <div class="text-primary">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div>
                                <strong class="text-slate-900 small d-block">Vigencia de la cotización:</strong>
                                <span class="text-slate-600 small">@q.RemainingTimeText</span>
                            </div>
                        </div>

                        <p class="instruction-lead">
                            Revisa cada trabajo sugerido por el equipo técnico. <strong>Puedes autorizar o rechazar cada uno por separado</strong> según tu criterio:
                        </p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                                <strong class="d-block mb-1">Por favor verifica los siguientes puntos antes de enviar:</strong>
                                <div asp-validation-summary="All" class="mb-0 small text-danger-emphasis"></div>
                            </div>
                        }

                        <form method="post" id="quoteResponseForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Input.Token" value="@Model.CurrentToken" />
                            <input type="hidden" asp-for="Input.QuoteId" value="@q.QuoteId" />

                            <div class="d-flex flex-column gap-3 mb-4">
                                @for (int i = 0; i < q.Items.Count; i++)
                                {
                                    var item = q.Items[i];
                                    var inputItem = Model.Input.Items.ElementAtOrDefault(i);
                                    var selectedDecision = inputItem?.Decision ?? CustomerDecision.SinSeleccionar;
                                    var isConfirmed = inputItem?.SecurityConfirmed ?? false;

                                    <div class="item-decision-card" id="card-@item.Id" data-item-id="@item.Id" data-amount="@item.TotalAmount" data-is-safety="@item.IsSafetyCritical.ToString().ToLowerInvariant()">
                                        <input type="hidden" name="Input.Items[@i].QuoteItemId" value="@item.Id" />
                                        <input type="hidden" name="Input.Items[@i].Description" value="@item.Description" />
                                        <input type="hidden" name="Input.Items[@i].IsSafetyCritical" value="@item.IsSafetyCritical.ToString().ToLowerInvariant()" />
                                        <input type="hidden" name="Input.Items[@i].TotalAmount" value="@item.TotalAmount" />

                                        <div class="item-card-inner">
                                            <!-- Encabezado del ítem -->
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                        <span class="category-tag">@item.TypeName</span>
                                                        @if (item.IsSafetyCritical)
                                                        {
                                                            <span class="category-tag safety-tag">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                                                </svg>
                                                                <span>Componente Crítico de Seguridad</span>
                                                            </span>
                                                        }
                                                        <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                                                                <circle cx="12" cy="12" r="3"></circle>
                                                            </svg>
                                                            <span>Ver en 3D</span>
                                                        </button>
                                                    </div>
                                                    <h3 class="item-title">@item.Description</h3>
                                                    <div class="item-meta">
                                                        Cantidad: <strong>@item.Quantity</strong> · Valor unitario: @item.UnitPriceFormatted
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <div class="item-price-amount">@item.TotalAmountFormatted</div>
                                                    <div class="item-tax-note">(IVA 19% incl.)</div>
                                                </div>
                                            </div>

                                            <!-- Opciones de decisión táctiles modernas -->
                                            <div class="decision-buttons-group" role="radiogroup" aria-label="Decisión para @item.Description">
                                                <label class="btn-decision btn-approve @(selectedDecision == CustomerDecision.Aprobar ? "active" : "")">
                                                    <input type="radio" 
                                                           name="Input.Items[@i].Decision" 
                                                           value="@((int)CustomerDecision.Aprobar)" 
                                                           class="decision-radio radio-approve" 
                                                           data-item-index="@i" 
                                                           @(selectedDecision == CustomerDecision.Aprobar ? "checked" : "") 
                                                           required />
                                                    <svg class="decision-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                    <span class="decision-text">Autorizar trabajo</span>
                                                </label>

                                                <label class="btn-decision btn-reject @(selectedDecision == CustomerDecision.Rechazar ? "active" : "")">
                                                    <input type="radio" 
                                                           name="Input.Items[@i].Decision" 
                                                           value="@((int)CustomerDecision.Rechazar)" 
                                                           class="decision-radio radio-reject" 
                                                           data-item-index="@i" 
                                                           @(selectedDecision == CustomerDecision.Rechazar ? "checked" : "") 
                                                           required />
                                                    <svg class="decision-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                    <span class="decision-text">No autorizar</span>
                                                </label>
                                            </div>

                                            <!-- Advertencia de seguridad condicional -->
                                            @if (item.IsSafetyCritical)
                                            {
                                                <div class="security-warning-box @(selectedDecision == CustomerDecision.Rechazar ? "" : "d-none")" id="security-warning-@i">
                                                    <div class="security-warning-header">
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-danger">
                                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                        </svg>
                                                        <span>Aviso de Seguridad Vial y Garantía</span>
                                                    </div>
                                                    <p class="security-warning-desc">
                                                        Este componente interviene directamente en la capacidad de detención y estabilidad de tu vehículo. Al rechazarlo, asumes la responsabilidad técnica de conducir con esta pieza desgastada.
                                                    </p>
                                                    <div class="security-check-container">
                                                        <input class="form-check-input security-checkbox" 
                                                               type="checkbox" 
                                                               name="Input.Items[@i].SecurityConfirmed" 
                                                               id="secConfirm-@i" 
                                                               value="true" 
                                                               @(isConfirmed ? "checked" : "") />
                                                        <label class="form-check-label" for="secConfirm-@i">
                                                            Entiendo los riesgos y confirmo expresamente NO realizar este trabajo de seguridad.
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Resumen económico en tiempo real -->
                            <div class="summary-receipt-card">
                                <div class="row align-items-center g-2">
                                    <div class="col-12 col-sm-6 summary-proposed-box">
                                        <div class="summary-total-title">Total de adicionales cotizados:</div>
                                        <div class="fs-6 fw-bold text-slate-700">@q.TotalProposedAmountFormatted</div>
                                    </div>
                                    <div class="col-12 col-sm-6 summary-authorized-box">
                                        <div class="summary-total-title text-primary">Total autorizado por ti:</div>
                                        <div class="summary-total-amount" id="liveAuthorizedTotal">$0</div>
                                        <div class="summary-count-sub" id="liveSelectionCount">0 de @q.Items.Count seleccionados</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Advertencia de envío definitivo y botón de acción -->
                            <div class="p-3 bg-light rounded-3 border mb-4 d-flex align-items-start gap-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 flex-shrink-0 mt-1">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span class="small text-slate-600">
                                    <strong>Registro de decisión en firme:</strong> Al enviar tu respuesta, el sistema del taller iniciará de inmediato el despacho de repuestos autorizados. Modificaciones posteriores requieren contacto telefónico directo.
                                </span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-submit-response">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                    <span>Confirmar y Enviar Respuesta Definitiva</span>
                                </button>
                            </div>

                            <!-- Barra flotante para celular con resumen en vivo -->
                            <div class="floating-mobile-bar">
                                <div>
                                    <div class="summary-total-title" style="font-size: 0.70rem;">Total autorizado:</div>
                                    <strong class="text-primary fs-5" id="mobileLiveAuthorizedTotal">$0</strong>
                                </div>
                                <button type="submit" class="btn-mobile-submit">
                                    <span>Enviar Respuesta</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    }
                }
            </div>
        </section>

        <!-- Pie de página informativo con contacto directo -->
        <footer class="text-center text-slate-500 small py-3 mb-5 border-top">
            <p class="mb-1"><strong>@t.WorkshopName</strong> · Sede Principal · Medellín, Colombia</p>
            <p class="mb-0">
                Atención personalizada al cliente: <a href="tel:@t.WorkshopPhone" class="text-primary fw-bold">@t.WorkshopPhone</a>
            </p>
        </footer>
    }
</div>

@section Scripts {
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script src="~/js/vehicle-3d-viewer.js" asp-append-version="true"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        @if (Model.Tracking != null)
        {
            var tTrack = Model.Tracking;
            <text>
            // 1. Inicializar Visor 3D del Vehículo con datos del modelo
            const itemsData = [
                @if (tTrack.Quote?.Items != null)
                {
                    @foreach (var itm in tTrack.Quote.Items)
                    {
                        <text>{ id: '@itm.Id', name: '@Html.Raw(itm.Description.Replace("'", "\\'"))', isSafety: @itm.IsSafetyCritical.ToString().ToLower() },</text>
                    }
                }
                else if (tTrack.Quote?.Response?.Items != null)
                {
                    @foreach (var itm in tTrack.Quote.Response.Items)
                    {
                        <text>{ id: '@itm.QuoteItemId', name: '@Html.Raw(itm.Description.Replace("'", "\\'"))', isSafety: @itm.IsSafetyCritical.ToString().ToLower() },</text>
                    }
                }
            ];

            const currentVehicleState = '@tTrack.CurrentProgressState.ToString()';

            const viewer = new Vehicle3DViewer('vehicle3dContainer', {
                vehiclePlate: '@tTrack.VehiclePlate',
                vehicleModel: '@tTrack.VehicleModel',
                currentState: currentVehicleState,
                items: itemsData
            });
            window.vehicleViewer = viewer;

            // 2. Conectar barra de herramientas de cámaras del visor 3D
            document.querySelectorAll('.btn-viewer-tool').forEach(btn => {
                btn.addEventListener('click', function () {
                    const action = this.dataset.action;
                    const target = this.dataset.target;

                    document.querySelectorAll('.btn-viewer-tool').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    if (action === 'reset') {
                        viewer.resetCameraView();
                    } else if (action === 'focus') {
                        viewer.focusPart(target);
                    } else if (action === 'toggle-lift') {
                        viewer.toggleLift();
                    }
                });
            });

            // 3. Botones "Ver en 3D" en cada tarjeta de cotización
            document.querySelectorAll('.btn-focus-3d').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const part = this.dataset.focusPart;
                    if (viewer) {
                        viewer.focusPart(part);
                        const container = document.getElementById('vehicle3dContainer');
                        if (container) {
                            container.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            });

            // 4. Si ya está respondida (Comprobante), reflejar las decisiones en el 3D
            @if (tTrack.Quote?.Response?.Items != null)
            {
                @foreach (var resItem in tTrack.Quote.Response.Items)
                {
                    var pKey = resItem.Description.ToLower().Contains("freno") || resItem.Description.ToLower().Contains("pastilla") ? "brakes"
                             : (resItem.Description.ToLower().Contains("plumilla") ? "wipers"
                             : (resItem.Description.ToLower().Contains("amortiguador") || resItem.Description.ToLower().Contains("suspens") ? "suspension" : "engine"));
                    var decStr = resItem.Decision == CustomerDecision.Aprobar ? "approve" : "reject";
                    <text>
                    setTimeout(() => {
                        if (viewer) viewer.updateHotspotStatus('@pKey', '@decStr');
                    }, 500);
                    </text>
                }
            }
            </text>
        }

        // 5. Lógica del formulario de cotización activa
        const form = document.getElementById('quoteResponseForm');
        if (!form) return;

        const liveTotalEl = document.getElementById('liveAuthorizedTotal');
        const mobileLiveTotalEl = document.getElementById('mobileLiveAuthorizedTotal');
        const liveCountEl = document.getElementById('liveSelectionCount');
        const cards = document.querySelectorAll('.item-decision-card');

        function formatColombianPesos(amount) {
            return '$' + Math.round(amount).toLocaleString('es-CO');
        }

        function updateCalculations() {
            let authorizedTotal = 0;
            let answeredCount = 0;
            const totalItems = cards.length;

            cards.forEach(card => {
                const amount = parseFloat(card.dataset.amount) || 0;
                const approveRadio = card.querySelector('.radio-approve');
                const rejectRadio = card.querySelector('.radio-reject');
                const isSafety = card.dataset.isSafety === 'true';
                const cardIndex = approveRadio ? approveRadio.dataset.itemIndex : null;
                const warningBox = cardIndex !== null ? document.getElementById('security-warning-' + cardIndex) : null;
                const securityCheckbox = warningBox ? warningBox.querySelector('.security-checkbox') : null;

                // Determinar componente para reflejar en el modelo 3D
                const focusBtn = card.querySelector('[data-focus-part]');
                const partKey = focusBtn ? focusBtn.dataset.focusPart : null;

                // Actualizar estilos activos de los botones
                const approveBtn = card.querySelector('.btn-approve');
                const rejectBtn = card.querySelector('.btn-reject');

                if (approveRadio && approveRadio.checked) {
                    authorizedTotal += amount;
                    answeredCount++;
                    approveBtn.classList.add('active');
                    if (rejectBtn) rejectBtn.classList.remove('active');
                    if (warningBox) warningBox.classList.add('d-none');
                    if (securityCheckbox) securityCheckbox.checked = false;

                    // Actualizar pin 3D en verde
                    if (partKey && window.vehicleViewer) {
                        window.vehicleViewer.updateHotspotStatus(partKey, 'approve');
                    }
                } else if (rejectRadio && rejectRadio.checked) {
                    answeredCount++;
                    if (approveBtn) approveBtn.classList.remove('active');
                    rejectBtn.classList.add('active');
                    if (isSafety && warningBox) {
                        warningBox.classList.remove('d-none');
                    }

                    // Actualizar pin 3D en rojo
                    if (partKey && window.vehicleViewer) {
                        window.vehicleViewer.updateHotspotStatus(partKey, 'reject');
                    }
                } else {
                    if (approveBtn) approveBtn.classList.remove('active');
                    if (rejectBtn) rejectBtn.classList.remove('active');
                    if (warningBox) warningBox.classList.add('d-none');
                }
            });

            const formattedTotal = formatColombianPesos(authorizedTotal);
            if (liveTotalEl) {
                liveTotalEl.textContent = formattedTotal;
            }
            if (mobileLiveTotalEl) {
                mobileLiveTotalEl.textContent = formattedTotal;
            }
            if (liveCountEl) {
                liveCountEl.textContent = `${answeredCount} de ${totalItems} seleccionados`;
            }
        }

        // Escuchar cambios en los radios
        document.querySelectorAll('.decision-radio').forEach(radio => {
            radio.addEventListener('change', updateCalculations);
        });

        // Validación al enviar el formulario
        form.addEventListener('submit', function (e) {
            let hasErrors = false;
            let firstErrorEl = null;

            cards.forEach(card => {
                const approveRadio = card.querySelector('.radio-approve');
                const rejectRadio = card.querySelector('.radio-reject');
                const isSafety = card.dataset.isSafety === 'true';
                const cardIndex = approveRadio ? approveRadio.dataset.itemIndex : null;
                const warningBox = cardIndex !== null ? document.getElementById('security-warning-' + cardIndex) : null;
                const securityCheckbox = warningBox ? warningBox.querySelector('.security-checkbox') : null;

                // 1. Debe haber seleccionado una opción
                if (!approveRadio.checked && !rejectRadio.checked) {
                    hasErrors = true;
                    card.style.borderColor = '#dc2626';
                    card.style.boxShadow = '0 0 0 3px rgba(220, 38, 38, 0.15)';
                    if (!firstErrorEl) firstErrorEl = card;
                } else {
                    card.style.borderColor = '';
                    card.style.boxShadow = '';
                }

                // 2. Si rechazó un ítem de seguridad, debe confirmar expresamente
                if (rejectRadio.checked && isSafety) {
                    if (securityCheckbox && !securityCheckbox.checked) {
                        hasErrors = true;
                        if (warningBox) {
                            warningBox.style.borderColor = '#dc2626';
                            warningBox.style.boxShadow = '0 0 0 3px rgba(220, 38, 38, 0.2)';
                            if (!firstErrorEl) firstErrorEl = warningBox;
                        }
                    }
                }
            });

            if (hasErrors) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'Decisiones incompletas',
                    html: '<p style="text-align:left;margin:0">Por favor selecciona <strong>Autorizar</strong> o <strong>No autorizar</strong> para cada ítem.<br><br>Si decides no realizar un trabajo de <strong>seguridad vial</strong>, debes marcar la casilla de confirmación requerida.</p>',
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#d97706',
                    customClass: { confirmButton: 'btn-lg' }
                }).then(() => {
                    if (firstErrorEl) {
                        firstErrorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }
        });

        // Inicializar cálculos al cargar la página
        updateCalculations();
    });
    </script>
}
