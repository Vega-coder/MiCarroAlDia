@page
@model IndexModel
@{
    ViewData["Title"] = "Mi Carro al Día - Panel de Demostración";
}

<div class="container py-4">
    <!-- Hero / Presentación del Caso -->
    <div class="hero-box p-4 p-md-5 mb-4 rounded-3 text-white">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-light text-primary fw-bold text-uppercase px-3 py-1">Prueba 5 — Desarrollo con IA</span>
            <span class="badge bg-info text-dark">ASP.NET Core .NET 10 LTS</span>
        </div>
        <h1 class="display-6 fw-bold">Mi Carro al Día</h1>
        <p class="fs-5 col-md-10">
            Solución web responsive, mobile-first y sin usuario ni contraseña, desarrollada para <strong>Autofrenos del Norte</strong>. Permite al cliente consultar el avance de su vehículo y autorizar o rechazar trabajos adicionales ítem por ítem desde su celular.
        </p>
        <div class="d-flex flex-wrap gap-2 pt-2">
            <span class="badge bg-white text-dark py-2 px-3">🎯 Prioridad P0: Recorrido del Cliente</span>
            <span class="badge bg-white text-dark py-2 px-3">🛡️ Confirmación de Seguridad</span>
            <span class="badge bg-white text-dark py-2 px-3">⏰ 48 Horas Continuas</span>
            <span class="badge bg-white text-dark py-2 px-3">🔒 Bloqueo Definitivo</span>
        </div>
        @if (TempData["GlobalMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
                <strong>✔️ Éxito:</strong> @TempData["GlobalMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    <!-- Acceso Rápido a los Escenarios de Demostración -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h2 class="h4 mb-0 text-primary-dark">Escenarios de Demostración Sembrados</h2>
                <small class="text-muted">Haz clic en cualquier tarjeta para abrir la vista móvil del cliente</small>
            </div>
            <form method="post" asp-page-handler="Reset" class="m-0">
                <button type="submit" class="btn btn-outline-primary btn-sm shadow-sm" title="Reinicia todas las órdenes y cotizaciones a su estado original de prueba">
                    🔄 Reiniciar datos de prueba
                </button>
            </form>
        </div>

        <div class="row g-3">
            <!-- Escenario 1: Cotización Pendiente (Flujo Principal P0) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-primary shadow-sm hover-shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning text-dark fw-bold">Pendiente (28h restantes)</span>
                        <small>Token: demo-activa</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="plate-pill">ABC-123</span>
                            <strong>Renault Sandero 1.6</strong>
                        </div>
                        <p class="card-text small text-muted">
                            Cliente: <strong>Carlos Mario Gómez</strong><br />
                            Estado del carro: <strong>Diagnóstico</strong><br />
                            Contiene 3 adicionales: Pastillas de freno (Seguridad), Mano de obra (Seguridad) y Plumillas (General).
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Permite probar la aprobación selectiva, el cálculo del 19% IVA, la advertencia de rechazo de seguridad y el envío definitivo.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="demo-activa" class="btn btn-primary w-100 fw-bold">
                            📲 Abrir vista del cliente →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Escenario 2: Cotización Respondida (Comprobante Bloqueado) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-success shadow-sm hover-shadow">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-success fw-bold">Respondida (Bloqueada)</span>
                        <small>Token: demo-respondida</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="plate-pill">XYZ-789</span>
                            <strong>Chevrolet Onix Turbo</strong>
                        </div>
                        <p class="card-text small text-muted">
                            Cliente: <strong>María Paula Restrepo</strong><br />
                            Estado del carro: <strong>Reparación</strong><br />
                            Respuestas ya enviadas: Amortiguadores y mano de obra aprobados, alineación rechazada.
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Demuestra el comprobante con fecha y hora, los totales autorizados y el bloqueo que impide cambiar la decisión desde el celular.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="demo-respondida" class="btn btn-outline-success w-100 fw-bold">
                            📋 Ver comprobante definitivo →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Escenario 3: Cotización Vencida (> 48h continuas) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-secondary shadow-sm hover-shadow">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <span class="badge bg-dark fw-bold">Vencida (&gt;48 horas)</span>
                        <small>Token: demo-vencida</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="plate-pill">KLR-456</span>
                            <strong>Toyota Hilux 4x4</strong>
                        </div>
                        <p class="card-text small text-muted">
                            Cliente: <strong>Héctor Fabio Ramírez</strong><br />
                            Estado del carro: <strong>Diagnóstico</strong><br />
                            Publicada hace 55 horas; el plazo de 48 horas continuas ya expiró.
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Demuestra el bloqueo para responder por celular y la visualización destacada del teléfono del taller para llamar al asesor.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="demo-vencida" class="btn btn-outline-secondary w-100 fw-bold">
                            ⏰ Ver vista vencida →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Escenario 4: Orden Sin Adicionales (Estado Vacío) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-info shadow-sm hover-shadow">
                    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                        <span class="badge bg-white text-dark fw-bold">Sin adicionales</span>
                        <small>Token: demo-sin-adicionales</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="plate-pill">MNO-321</span>
                            <strong>Kia Picanto Ion</strong>
                        </div>
                        <p class="card-text small text-muted">
                            Cliente: <strong>Luisa Fernanda Duque</strong><br />
                            Estado del carro: <strong>Listo para entregar</strong><br />
                            Mantenimiento rutinario sin daños imprevistos.
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Comprueba el mensaje de estado vacío amigable acordado y la visualización completa de la línea de tiempo del avance.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="demo-sin-adicionales" class="btn btn-outline-info w-100 fw-bold">
                            🚗 Consultar avance listo →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Escenario 5: Aislamiento Multitenant (Serviteca del Sur) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-warning shadow-sm hover-shadow">
                    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                        <span class="badge bg-dark text-white fw-bold">Otro Taller (Multitenant)</span>
                        <small>Token: demo-taller-sur</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="plate-pill">SUR-555</span>
                            <strong>Nissan Versa Advance</strong>
                        </div>
                        <p class="card-text small text-muted">
                            Taller: <strong>Serviteca y Frenos del Sur</strong><br />
                            Cliente: <strong>Andrés Felipe Uribe</strong><br />
                            Comprueba el aislamiento entre talleres acordado para don Álvaro.
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Verifica que la resolución del token asocia exclusivamente al taller correspondiente sin mezclar datos de clientes.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="demo-taller-sur" class="btn btn-outline-warning w-100 fw-bold text-dark">
                            🏢 Ver aislamiento taller →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Enlace inválido para verificar seguridad -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-danger shadow-sm hover-shadow">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <span class="badge bg-white text-danger fw-bold">Enlace inválido</span>
                        <small>Token: token-falso</small>
                    </div>
                    <div class="card-body">
                        <h3 class="h6 fw-bold">Control de Acceso Seguro</h3>
                        <p class="card-text small text-muted">
                            Si un usuario intenta alterar el identificador o ingresar un token inexistente, el sistema no revela datos de ningún vehículo.
                        </p>
                        <div class="p-2 bg-light rounded small mb-3">
                            <em>Cumple RF-01 y RF-02 evitando enumeración o filtración de placas e información privada de clientes.</em>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-page="/Tracking/Index" asp-route-token="token-inexistente-123" class="btn btn-outline-danger w-100 fw-bold">
                            🛡️ Probar enlace inválido →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Prueba manual de Token -->
    <div class="card shadow-sm border-0 bg-light p-4 mb-4">
        <h3 class="h5 text-primary-dark mb-2">Probar un token de enlace específico</h3>
        <p class="text-muted small mb-3">
            Ingresa manualmente cualquier clave de acceso o abre directamente en tu navegador la URL: <code>/Tracking/{token}</code> o <code>/t/{token}</code>
        </p>
        <form method="post" class="row g-2 align-items-center">
            <div class="col-auto flex-grow-1">
                <label for="customToken" class="visually-hidden">Token de acceso</label>
                <input type="text" asp-for="CustomToken" id="customToken" class="form-control form-control-lg" placeholder="Ejemplo: demo-activa" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-lg px-4">
                    Consultar vehículo
                </button>
            </div>
        </form>
    </div>
</div>
