@page "{token?}"
@model MiCarroAlDia.Web.Pages.Tracking.IndexModel
@using MiCarroAlDia.Domain.Enums
@{
    ViewData["Title"] = Model.Tracking != null 
        ? $"Avance de {Model.Tracking.VehiclePlate} - Mi Carro al Día" 
        : "Consulta de vehículo - Mi Carro al Día";
}

<div class="tracking-container">
    @if (Model.IsNotFound || Model.Tracking == null)
    {
        <div class="card error-card">
            <div class="card-header bg-danger text-white">
                <h1 class="h4 mb-0">Enlace no disponible o inválido</h1>
            </div>
            <div class="card-body">
                <p class="lead">
                    No encontramos información para este enlace o el enlace ha caducado.
                </p>
                <p>
                    Por seguridad y para proteger la privacidad de cada cliente, cada enlace es único y está asociado exclusivamente a su vehículo.
                </p>
                <div class="alert alert-info">
                    <strong>¿Necesitas consultar tu vehículo?</strong><br />
                    Comunícate directamente con tu asesora de servicio en el taller <strong>Autofrenos del Norte</strong> para que te comparta un nuevo enlace por WhatsApp.
                    <div class="mt-2">
                        <a href="tel:+576044441234" class="btn btn-primary btn-call">
                            📞 Llamar al taller: +57 (604) 444-1234
                        </a>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-page="/Index" class="btn btn-outline-secondary">← Volver al inicio</a>
                </div>
            </div>
        </div>
    }
    else
    {
        var t = Model.Tracking;
        var completedStepsCount = t.ProgressSteps.Count(s => s.IsCompleted);
        var totalStepsCount = t.ProgressSteps.Count;
        var progressPercentage = totalStepsCount > 0 ? (int)Math.Round((double)completedStepsCount / totalStepsCount * 100) : 0;
        var currentStepIndex = t.ProgressSteps.ToList().FindIndex(s => s.IsCurrent);
        if (currentStepIndex < 0) currentStepIndex = completedStepsCount - 1;

        <!-- Encabezado de Identificación del Vehículo y Taller -->
        <header class="app-header mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-primary text-uppercase px-3 py-2 fs-6 shadow-sm">Mi Carro al Día</span>
                    <h1 class="h3 mt-2 mb-0 text-primary-dark">@t.WorkshopName</h1>
                    <p class="text-muted mb-0 small">@t.WorkshopAddress — @t.WorkshopCity</p>
                </div>
                <div class="text-end">
                    <a href="tel:@t.WorkshopPhone" class="btn btn-outline-primary btn-sm btn-touch-sm shadow-sm" title="Llamar al taller">
                        📞 @t.WorkshopPhone
                    </a>
                </div>
            </div>

            <!-- Ficha del Vehículo Amigable e Intuitiva -->
            <div class="vehicle-card mt-3 shadow-sm bg-white p-3 rounded-3 border">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="plate-badge" aria-label="Placa del vehículo">
                            <span>COLOMBIA</span>
                            <strong>@t.VehiclePlate</strong>
                        </div>
                        <div>
                            <div class="vehicle-model">@t.VehicleModel</div>
                            <div class="customer-name">¡Hola, <strong>@t.CustomerName</strong>! 👋</div>
                        </div>
                    </div>
                    <div>
                        <span class="badge @(t.CurrentProgressState == VehicleProgressState.ListoParaEntregar ? "bg-success" : "bg-primary") fs-6 px-3 py-2 rounded-pill shadow-sm">
                            ● @t.CurrentProgressStateName
                        </span>
                    </div>
                </div>
            </div>
        </header>

        @if (TempData["SuccessFeedback"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <h4 class="alert-heading mb-1">✔️ ¡Respuesta Registrada con Éxito!</h4>
                <p class="mb-0">@TempData["SuccessFeedback"]</p>
            </div>
        }

        @if (TempData["InfoFeedback"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <h4 class="alert-heading mb-1">ℹ️ Información</h4>
                <p class="mb-0">@TempData["InfoFeedback"]</p>
            </div>
        }

        <!-- Bloque 1: Stepper Visual e Intuitivo del Avance -->
        <section class="card mb-4 shadow-sm border-0 stepper-progress-box" aria-labelledby="heading-progress">
            <div class="stepper-header">
                <div>
                    <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-2 py-1">
                        Etapa @(currentStepIndex + 1) de @totalStepsCount
                    </span>
                    <h2 id="heading-progress" class="h5 mb-0 mt-1 fw-bold text-dark">
                        🚗 ¿Cómo va tu carro hoy?
                    </h2>
                </div>
                <div class="text-end">
                    <span class="badge bg-success-subtle text-success fw-bold px-3 py-2 fs-6">
                        @progressPercentage% Avance Total
                    </span>
                </div>
            </div>

            <!-- Línea de tiempo visual horizontal con nodos e iconos -->
            <div class="stepper-pills-row" role="progressbar" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100">
                <div class="stepper-track-bg">
                    <div class="stepper-track-fill" style="width: @progressPercentage%;"></div>
                </div>
                @foreach (var step in t.ProgressSteps)
                {
                    var nodeClass = step.IsCurrent ? "stepper-node current" : (step.IsCompleted ? "stepper-node completed" : "stepper-node pending");
                    var stepIcon = step.State switch {
                        VehicleProgressState.Recibido => "📥",
                        VehicleProgressState.Diagnostico => "🔍",
                        VehicleProgressState.Reparacion => "🛠️",
                        VehicleProgressState.ControlDeCalidad => "🛡️",
                        VehicleProgressState.ListoParaEntregar => "🚗",
                        _ => "🎉"
                    };

                    <div class="@nodeClass">
                        <div class="stepper-node-circle" title="@step.Name">
                            @if (step.IsCompleted && !step.IsCurrent)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>@stepIcon</span>
                            }
                        </div>
                        <span class="stepper-node-label">@step.Name</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(t.CurrentProgressStateDescription))
            {
                <div class="mt-4 p-3 bg-light rounded-3 border-start border-4 border-primary">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fs-5">👨‍🔧</span>
                        <strong class="text-dark">Actualización técnica de taller:</strong>
                    </div>
                    <p class="mb-0 text-secondary">@t.CurrentProgressStateDescription</p>
                </div>
            }
        </section>

        <!-- Bloque 2: Visor 3D Interactivo del Carro y Partes Requeridas -->
        <section class="card mb-4 vehicle-3d-card shadow" aria-labelledby="heading-3d">
            <div class="vehicle-3d-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">🚘</span>
                    <div>
                        <h2 id="heading-3d" class="h6 mb-0 text-white fw-bold">
                            Tu Vehículo en 3D — Diagnóstico y Partes
                        </h2>
                        <small class="text-info">@t.VehicleModel · Placa @t.VehiclePlate</small>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-primary text-white px-3 py-1">
                        Modo Taller 3D Activo
                    </span>
                </div>
            </div>

            <!-- Contenedor del Lienzo Three.js con Overlay de Pines -->
            <div class="vehicle-3d-wrapper" id="vehicle3dContainer">
                <div class="touch-hint-pill">
                    👆 Arrastra con el dedo para girar 360° · Toca los puntos para ver el estado
                </div>
            </div>

            <!-- Barra de Herramientas para Enfoque Rápido de Partes en 3D -->
            <div class="viewer-toolbar">
                <button type="button" class="btn-viewer-tool active" data-action="reset">
                    🔄 Vista 360°
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="brakes">
                    🛑 Frenos Delanteros
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="wipers">
                    🌧️ Limpiaparabrisas
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="suspension">
                    🔩 Suspensión
                </button>
                <button type="button" class="btn-viewer-tool" data-action="focus" data-target="engine">
                    ⚙️ Motor
                </button>
                <button type="button" class="btn-viewer-tool" data-action="toggle-lift" id="btnToggleLift">
                    ⬆️ Subir / Bajar en Rampa
                </button>
            </div>

            <!-- ¿Qué le están haciendo a tu carro ahora? (Tiempo Real) -->
            <div class="status-doing-banner">
                <div class="d-flex align-items-start gap-2">
                    <span class="status-doing-badge">
                        🛠️ ¿Qué le están haciendo a tu carro ahora?
                    </span>
                </div>
                <p class="status-doing-text" id="statusDoingText">
                    @if (t.CurrentProgressState == VehicleProgressState.Diagnostico)
                    {
                        <span>
                            <strong>Inspección técnica en elevador:</strong> Tu vehículo está montado en el elevador hidráulico. El mecánico especialista está midiendo el grosor de las pastillas y evaluando discos de freno y suspensión.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.Reparacion)
                    {
                        <span>
                            <strong>Proceso de reparación activo:</strong> El técnico asignado está instalando los repuestos autorizados y realizando los ajustes de torque correspondientes.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.ControlDeCalidad)
                    {
                        <span>
                            <strong>Control de calidad y pruebas dinámicas:</strong> Verificando la frenada en dinamómetro y comprobando la seguridad integral antes de entrega.
                        </span>
                    }
                    else if (t.CurrentProgressState == VehicleProgressState.ListoParaEntregar)
                    {
                        <span>
                            <strong>Vehículo alistado y listo:</strong> Todos los trabajos fueron culminados con éxito. Tu carro está limpio y listo para ser recogido.
                        </span>
                    }
                    else
                    {
                        <span>
                            <strong>Recepción e inventario:</strong> Tu carro ingresó a las instalaciones del taller y se asignó puesto de trabajo.
                        </span>
                    }
                </p>
            </div>
        </section>

        <!-- Bloque 2: Trabajos Adicionales Encontrados -->
        <section class="card shadow-sm section-quotes mb-4" aria-labelledby="heading-quotes">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 id="heading-quotes" class="h5 mb-0 text-primary-dark">
                    🔧 Trabajos Adicionales Detectados
                </h2>
                @if (t.Quote != null)
                {
                    <span class="badge @(t.Quote.Status == QuoteStatus.Respondida ? "bg-success" : (t.Quote.Status == QuoteStatus.Vencida ? "bg-secondary" : "bg-warning text-dark")) px-3 py-2">
                        @t.Quote.StatusFriendlyName
                    </span>
                }
            </div>

            <div class="card-body">
                @if (!t.HasAdditionalQuote || t.Quote == null)
                {
                    <!-- Estado vacío acordado -->
                    <div class="empty-state text-center py-4">
                        <div class="empty-icon fs-1 mb-2">📋</div>
                        <h3 class="h5 text-secondary">Por ahora no tienes trabajos adicionales pendientes de revisar</h3>
                        <p class="text-muted mb-0">
                            Nuestros técnicos continúan trabajando en tu vehículo según el servicio inicial acordado. Si se detecta alguna novedad durante la inspección técnica, te notificaremos por este medio.
                        </p>
                    </div>
                }
                else
                {
                    var q = t.Quote;

                    @if (q.Status == QuoteStatus.Respondida && q.Response != null)
                    {
                        <!-- ESTADO RESPONDIDO: Comprobante Definitivo -->
                        <div class="response-proof-box mb-4">
                            <div class="alert alert-success d-flex align-items-start gap-3">
                                <span class="fs-2">📋</span>
                                <div>
                                    <h3 class="h6 mb-1 text-success-emphasis fw-bold">Comprobante de Respuesta Registrada</h3>
                                    <p class="mb-1">
                                        Tus decisiones fueron guardadas definitivamente en el sistema del taller el <strong>@q.Response.SubmittedAtFormatted</strong>.
                                    </p>
                                    <small class="text-muted">
                                        Por seguridad del proceso de taller, estas decisiones ya no se pueden modificar desde el celular. Si requieres coordinar un cambio, por favor llama a Marcela al <a href="tel:@t.WorkshopPhone" class="fw-bold">@t.WorkshopPhone</a>.
                                    </small>
                                </div>
                            </div>

                            <!-- Resumen económico respondido -->
                            <div class="row g-3 my-3">
                                <div class="col-12 col-md-6">
                                    <div class="p-3 bg-light rounded border">
                                        <div class="text-muted small">Total de adicionales propuestos:</div>
                                        <div class="fs-5 fw-bold text-dark">@q.TotalProposedAmountFormatted</div>
                                        <div class="small text-muted">(Base: @q.TotalProposedBaseFormatted + IVA 19%: @q.TotalProposedIvaFormatted)</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="p-3 bg-primary-subtle rounded border border-primary">
                                        <div class="text-primary-dark small fw-bold">Total de adicionales autorizados:</div>
                                        <div class="fs-4 fw-bold text-primary">@q.Response.TotalAuthorizedAmountFormatted</div>
                                        <div class="small text-muted">(Base: @q.Response.TotalAuthorizedBaseFormatted + IVA 19%: @q.Response.TotalAuthorizedIvaFormatted)</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detalle de decisiones ítems respondidos -->
                            <h4 class="h6 fw-bold mt-4 mb-3">Detalle de lo que respondiste ítem por ítem:</h4>
                            <div class="list-group">
                                @foreach (var item in q.Response.Items)
                                {
                                    <div class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <span class="badge bg-secondary">@item.TypeName</span>
                                                    @if (item.IsSafetyCritical)
                                                    {
                                                        <span class="badge bg-danger">🛡️ Ítem de Seguridad</span>
                                                    }
                                                    <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                        🎯 Ver en 3D
                                                    </button>
                                                </div>
                                                <h5 class="h6 mt-2 mb-1 fw-bold">@item.Description</h5>
                                                <div class="text-muted small">
                                                    Cantidad: @item.Quantity × @item.UnitPriceFormatted (IVA 19% incluido)
                                                </div>
                                                @if (item.Decision == CustomerDecision.Rechazar && item.IsSafetyCritical && item.SecurityRejectionConfirmed)
                                                {
                                                    <div class="mt-2 text-danger small bg-danger-subtle p-2 rounded">
                                                        ⚠️ Rechazo de seguridad confirmado expresamente por el cliente.
                                                    </div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <div class="fs-6 fw-bold mb-2">@item.TotalAmountFormatted</div>
                                                @if (item.Decision == CustomerDecision.Aprobar)
                                                {
                                                    <span class="badge bg-success fs-6 py-2 px-3">✔️ Aprobado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger fs-6 py-2 px-3">✖️ Rechazado</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (q.Status == QuoteStatus.Vencida)
                    {
                        <!-- ESTADO VENCIDO (> 48 horas continuas) -->
                        <div class="alert alert-warning border-warning shadow-sm p-4 mb-4">
                            <div class="d-flex gap-3 align-items-start">
                                <span class="fs-1">⏰</span>
                                <div>
                                    <h3 class="h5 fw-bold text-dark mb-2">El plazo de 48 horas para responder ha vencido</h3>
                                    <p class="mb-2">
                                        Esta solicitud fue publicada el <strong>@q.PublishedAtFormatted</strong> y su vigencia expiró el <strong>@q.ExpiresAtFormatted</strong>.
                                    </p>
                                    <p class="mb-3">
                                        Para evitar demoras en el taller y no retener el puesto de trabajo, el formulario de autorización por celular ya no recibe respuestas.
                                    </p>
                                    <div class="p-3 bg-white rounded border border-warning d-inline-block">
                                        <p class="mb-1 fw-bold text-dark">Por favor comunícate directamente con el taller:</p>
                                        <a href="tel:@t.WorkshopPhone" class="btn btn-primary btn-call mt-1">
                                            📞 Llamar al asesor: @t.WorkshopPhone
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de ítems en modo solo lectura -->
                        <h4 class="h6 fw-bold mb-3">Trabajos adicionales que fueron solicitados:</h4>
                        <div class="list-group mb-3 opacity-75">
                            @foreach (var item in q.Items)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <span class="badge bg-secondary">@item.TypeName</span>
                                                @if (item.IsSafetyCritical)
                                                {
                                                    <span class="badge bg-danger">🛡️ Ítem de Seguridad</span>
                                                }
                                                <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                    🎯 Ver en 3D
                                                </button>
                                            </div>
                                            <div class="fw-bold mt-1">@item.Description</div>
                                            <small class="text-muted">Cantidad: @item.Quantity | Base: @item.BaseAmountFormatted + IVA: @item.IvaAmountFormatted</small>
                                        </div>
                                        <div class="text-end fw-bold fs-6">
                                            @item.TotalAmountFormatted
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-end text-muted small">
                            Total propuesto: <strong>@q.TotalProposedAmountFormatted</strong>
                        </div>
                    }
                    else
                    {
                        <!-- ESTADO PENDIENTE: Formulario Activo con Decisiones Ítem por Ítem -->
                        <div class="alert alert-primary bg-primary-subtle border-primary mb-4">
                            <div class="d-flex gap-2 align-items-center mb-1">
                                <span class="fs-5">⏱️</span>
                                <strong class="text-primary-dark">Plazo de 48 horas continuas</strong>
                            </div>
                            <p class="mb-0 small">
                                @q.RemainingTimeText
                            </p>
                        </div>

                        <p class="instruction-lead">
                            Revisa cada trabajo adicional a continuación. <strong>Puedes aprobar o rechazar cada uno por separado</strong> según tu necesidad:
                        </p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                                <h4 class="h6 fw-bold mb-2">⚠️ Por favor corrige los siguientes puntos antes de enviar:</h4>
                                <div asp-validation-summary="All" class="mb-0 text-danger-emphasis"></div>
                            </div>
                        }

                        <form method="post" id="quoteResponseForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Input.Token" value="@Model.CurrentToken" />
                            <input type="hidden" asp-for="Input.QuoteId" value="@q.QuoteId" />

                            <div class="items-container d-flex flex-column gap-3 mb-4">
                                @for (int i = 0; i < q.Items.Count; i++)
                                {
                                    var item = q.Items[i];
                                    var inputItem = Model.Input.Items.ElementAtOrDefault(i);
                                    var selectedDecision = inputItem?.Decision ?? CustomerDecision.SinSeleccionar;
                                    var isConfirmed = inputItem?.SecurityConfirmed ?? false;

                                    <div class="card item-decision-card border" id="card-@item.Id" data-item-id="@item.Id" data-amount="@item.TotalAmount" data-is-safety="@item.IsSafetyCritical.ToString().ToLowerInvariant()">
                                        <input type="hidden" name="Input.Items[@i].QuoteItemId" value="@item.Id" />
                                        <input type="hidden" name="Input.Items[@i].Description" value="@item.Description" />
                                        <input type="hidden" name="Input.Items[@i].IsSafetyCritical" value="@item.IsSafetyCritical.ToString().ToLowerInvariant()" />
                                        <input type="hidden" name="Input.Items[@i].TotalAmount" value="@item.TotalAmount" />

                                        <div class="card-body p-3">
                                            <!-- Encabezado del ítem -->
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                        <span class="badge bg-secondary">@item.TypeName</span>
                                                        @if (item.IsSafetyCritical)
                                                        {
                                                            <span class="badge bg-danger">🛡️ Trabajo de Seguridad (Frenos / Suspensión)</span>
                                                        }
                                                        <button type="button" class="btn-focus-3d" data-focus-part="@(item.Description.ToLower().Contains("freno") || item.Description.ToLower().Contains("pastilla") ? "brakes" : (item.Description.ToLower().Contains("plumilla") ? "wipers" : (item.Description.ToLower().Contains("amortiguador") || item.Description.ToLower().Contains("suspens") ? "suspension" : "engine")))">
                                                            🎯 Ver en 3D
                                                        </button>
                                                    </div>
                                                    <h3 class="h5 fw-bold mb-1 item-title">@item.Description</h3>
                                                    <div class="text-muted small">
                                                        Cantidad: <strong>@item.Quantity</strong> | Precio unitario: @item.UnitPriceFormatted
                                                    </div>
                                                </div>
                                                <div class="text-end item-price-box">
                                                    <div class="item-total-amount fs-5 fw-bold text-dark">@item.TotalAmountFormatted</div>
                                                    <div class="item-tax-note text-muted small">(IVA 19% incl.)</div>
                                                </div>
                                            </div>

                                            <!-- Opciones de decisión grandes para celular -->
                                            <div class="decision-buttons-group my-3" role="radiogroup" aria-label="Decisión para @item.Description">
                                                <label class="btn-decision btn-approve @(selectedDecision == CustomerDecision.Aprobar ? "active" : "")">
                                                    <input type="radio" 
                                                           name="Input.Items[@i].Decision" 
                                                           value="@((int)CustomerDecision.Aprobar)" 
                                                           class="decision-radio radio-approve" 
                                                           data-item-index="@i" 
                                                           @(selectedDecision == CustomerDecision.Aprobar ? "checked" : "") 
                                                           required />
                                                    <span class="decision-icon">✔️</span>
                                                    <span class="decision-text">Aprobar este trabajo</span>
                                                </label>

                                                <label class="btn-decision btn-reject @(selectedDecision == CustomerDecision.Rechazar ? "active" : "")">
                                                    <input type="radio" 
                                                           name="Input.Items[@i].Decision" 
                                                           value="@((int)CustomerDecision.Rechazar)" 
                                                           class="decision-radio radio-reject" 
                                                           data-item-index="@i" 
                                                           @(selectedDecision == CustomerDecision.Rechazar ? "checked" : "") 
                                                           required />
                                                    <span class="decision-icon">✖️</span>
                                                    <span class="decision-text">Rechazar este trabajo</span>
                                                </label>
                                            </div>

                                            <!-- Advertencia de seguridad condicional -->
                                            @if (item.IsSafetyCritical)
                                            {
                                                <div class="security-warning-box mt-3 p-3 bg-danger-subtle border border-danger rounded @(selectedDecision == CustomerDecision.Rechazar ? "" : "d-none")" id="security-warning-@i">
                                                    <div class="d-flex gap-2 align-items-start">
                                                        <span class="fs-4">⚠️</span>
                                                        <div>
                                                            <strong class="text-danger-emphasis d-block mb-1">
                                                                Estás rechazando un trabajo relacionado con la seguridad de tu vehículo.
                                                            </strong>
                                                            <p class="small text-danger-emphasis mb-2">
                                                                Este componente (frenos, dirección, suspensión o llantas) es indispensable para la conducción segura. Revisa el detalle antes de continuar. Para confirmar tu decisión de no realizarlo, marca la siguiente casilla:
                                                            </p>
                                                            <div class="form-check security-check-container">
                                                                <input class="form-check-input security-checkbox" 
                                                                       type="checkbox" 
                                                                       name="Input.Items[@i].SecurityConfirmed" 
                                                                       id="secConfirm-@i" 
                                                                       value="true" 
                                                                       @(isConfirmed ? "checked" : "") />
                                                                <label class="form-check-label fw-bold small text-danger" for="secConfirm-@i">
                                                                    Confirmo expresamente que decido NO realizar este trabajo de seguridad.
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Resumen económico en tiempo real -->
                            <div class="card summary-card bg-light border-primary p-3 mb-4 shadow-sm">
                                <div class="row align-items-center g-2">
                                    <div class="col-12 col-sm-6">
                                        <div class="text-muted small">Total de adicionales propuestos:</div>
                                        <div class="fs-6 fw-bold text-secondary">@q.TotalProposedAmountFormatted</div>
                                    </div>
                                    <div class="col-12 col-sm-6 text-sm-end">
                                        <div class="text-primary-dark small fw-bold">Total de adicionales autorizados:</div>
                                        <div class="fs-4 fw-bold text-primary" id="liveAuthorizedTotal">$0</div>
                                        <div class="small text-muted" id="liveSelectionCount">0 de @q.Items.Count trabajos seleccionados</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Advertencia de envío definitivo y botón de acción -->
                            <div class="alert alert-warning border-warning p-3 mb-4">
                                <div class="d-flex gap-2 align-items-start">
                                    <span class="fs-5">ℹ️</span>
                                    <div class="small text-dark">
                                        <strong>Respuesta definitiva:</strong> Una vez envíes tu respuesta, tus decisiones quedarán bloqueadas y guardadas de inmediato con fecha y hora. Si te arrepientes o requieres un cambio, deberás llamar al taller.
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-submit-response py-3 fs-5 fw-bold shadow">
                                    📤 Enviar mi respuesta definitiva
                                </button>
                            </div>

                            <!-- Barra flotante para celular con resumen en vivo -->
                            <div class="floating-mobile-bar shadow-lg">
                                <div>
                                    <div class="small text-muted" style="font-size:0.75rem;">Total autorizado:</div>
                                    <strong class="text-primary fs-5" id="mobileLiveAuthorizedTotal">$0</strong>
                                </div>
                                <button type="submit" class="btn btn-primary fw-bold px-4 py-2">
                                    Enviar respuesta 📤
                                </button>
                            </div>
                        </form>
                    }
                }
            </div>
        </section>

        <!-- Pie de página informativo con contacto directo -->
        <footer class="text-center text-muted small py-3 mb-5 border-top">
            <p class="mb-1"><strong>@t.WorkshopName</strong> · Medellín, Colombia</p>
            <p class="mb-0">
                Línea de atención directa: <a href="tel:@t.WorkshopPhone" class="text-primary fw-bold">@t.WorkshopPhone</a>
            </p>
        </footer>
    }
</div>

@section Scripts {
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script src="~/js/vehicle-3d-viewer.js" asp-append-version="true"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        @if (Model.Tracking != null)
        {
            var tTrack = Model.Tracking;
            <text>
            // 1. Inicializar Visor 3D del Vehículo con datos del modelo
            const itemsData = [
                @if (tTrack.Quote?.Items != null)
                {
                    @foreach (var itm in tTrack.Quote.Items)
                    {
                        <text>{ id: '@itm.Id', name: '@Html.Raw(itm.Description.Replace("'", "\\'"))', isSafety: @itm.IsSafetyCritical.ToString().ToLower() },</text>
                    }
                }
                else if (tTrack.Quote?.Response?.Items != null)
                {
                    @foreach (var itm in tTrack.Quote.Response.Items)
                    {
                        <text>{ id: '@itm.QuoteItemId', name: '@Html.Raw(itm.Description.Replace("'", "\\'"))', isSafety: @itm.IsSafetyCritical.ToString().ToLower() },</text>
                    }
                }
            ];

            const currentVehicleState = '@tTrack.CurrentProgressState.ToString()';

            const viewer = new Vehicle3DViewer('vehicle3dContainer', {
                vehiclePlate: '@tTrack.VehiclePlate',
                vehicleModel: '@tTrack.VehicleModel',
                currentState: currentVehicleState,
                items: itemsData
            });
            window.vehicleViewer = viewer;

            // 2. Conectar barra de herramientas de cámaras del visor 3D
            document.querySelectorAll('.btn-viewer-tool').forEach(btn => {
                btn.addEventListener('click', function () {
                    const action = this.dataset.action;
                    const target = this.dataset.target;

                    document.querySelectorAll('.btn-viewer-tool').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    if (action === 'reset') {
                        viewer.resetCameraView();
                    } else if (action === 'focus') {
                        viewer.focusPart(target);
                    } else if (action === 'toggle-lift') {
                        viewer.toggleLift();
                    }
                });
            });

            // 3. Botones "Ver en 3D" en cada tarjeta de cotización
            document.querySelectorAll('.btn-focus-3d').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const part = this.dataset.focusPart;
                    if (viewer) {
                        viewer.focusPart(part);
                        const container = document.getElementById('vehicle3dContainer');
                        if (container) {
                            container.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            });

            // 4. Si ya está respondida (Comprobante), reflejar las decisiones en el 3D
            @if (tTrack.Quote?.Response?.Items != null)
            {
                @foreach (var resItem in tTrack.Quote.Response.Items)
                {
                    var pKey = resItem.Description.ToLower().Contains("freno") || resItem.Description.ToLower().Contains("pastilla") ? "brakes"
                             : (resItem.Description.ToLower().Contains("plumilla") ? "wipers"
                             : (resItem.Description.ToLower().Contains("amortiguador") || resItem.Description.ToLower().Contains("suspens") ? "suspension" : "engine"));
                    var decStr = resItem.Decision == CustomerDecision.Aprobar ? "approve" : "reject";
                    <text>
                    setTimeout(() => {
                        if (viewer) viewer.updateHotspotStatus('@pKey', '@decStr');
                    }, 500);
                    </text>
                }
            }
            </text>
        }

        // 5. Lógica del formulario de cotización activa
        const form = document.getElementById('quoteResponseForm');
        if (!form) return;

        const liveTotalEl = document.getElementById('liveAuthorizedTotal');
        const mobileLiveTotalEl = document.getElementById('mobileLiveAuthorizedTotal');
        const liveCountEl = document.getElementById('liveSelectionCount');
        const cards = document.querySelectorAll('.item-decision-card');

        function formatColombianPesos(amount) {
            return '$' + Math.round(amount).toLocaleString('es-CO');
        }

        function updateCalculations() {
            let authorizedTotal = 0;
            let answeredCount = 0;
            const totalItems = cards.length;

            cards.forEach(card => {
                const amount = parseFloat(card.dataset.amount) || 0;
                const approveRadio = card.querySelector('.radio-approve');
                const rejectRadio = card.querySelector('.radio-reject');
                const isSafety = card.dataset.isSafety === 'true';
                const cardIndex = approveRadio ? approveRadio.dataset.itemIndex : null;
                const warningBox = cardIndex !== null ? document.getElementById('security-warning-' + cardIndex) : null;
                const securityCheckbox = warningBox ? warningBox.querySelector('.security-checkbox') : null;

                // Determinar componente para reflejar en el modelo 3D
                const focusBtn = card.querySelector('[data-focus-part]');
                const partKey = focusBtn ? focusBtn.dataset.focusPart : null;

                // Actualizar estilos activos de los botones
                const approveBtn = card.querySelector('.btn-approve');
                const rejectBtn = card.querySelector('.btn-reject');

                if (approveRadio && approveRadio.checked) {
                    authorizedTotal += amount;
                    answeredCount++;
                    approveBtn.classList.add('active');
                    if (rejectBtn) rejectBtn.classList.remove('active');
                    if (warningBox) warningBox.classList.add('d-none');
                    if (securityCheckbox) securityCheckbox.checked = false;

                    // Actualizar pin 3D en verde
                    if (partKey && window.vehicleViewer) {
                        window.vehicleViewer.updateHotspotStatus(partKey, 'approve');
                    }
                } else if (rejectRadio && rejectRadio.checked) {
                    answeredCount++;
                    if (approveBtn) approveBtn.classList.remove('active');
                    rejectBtn.classList.add('active');
                    if (isSafety && warningBox) {
                        warningBox.classList.remove('d-none');
                    }

                    // Actualizar pin 3D en rojo
                    if (partKey && window.vehicleViewer) {
                        window.vehicleViewer.updateHotspotStatus(partKey, 'reject');
                    }
                } else {
                    if (approveBtn) approveBtn.classList.remove('active');
                    if (rejectBtn) rejectBtn.classList.remove('active');
                    if (warningBox) warningBox.classList.add('d-none');
                }
            });

            const formattedTotal = formatColombianPesos(authorizedTotal);
            if (liveTotalEl) {
                liveTotalEl.textContent = formattedTotal;
            }
            if (mobileLiveTotalEl) {
                mobileLiveTotalEl.textContent = formattedTotal;
            }
            if (liveCountEl) {
                liveCountEl.textContent = `${answeredCount} de ${totalItems} trabajos seleccionados`;
            }
        }

        // Escuchar cambios en los radios
        document.querySelectorAll('.decision-radio').forEach(radio => {
            radio.addEventListener('change', updateCalculations);
        });

        // Validación al enviar el formulario
        form.addEventListener('submit', function (e) {
            let hasErrors = false;
            let firstErrorEl = null;

            cards.forEach(card => {
                const approveRadio = card.querySelector('.radio-approve');
                const rejectRadio = card.querySelector('.radio-reject');
                const isSafety = card.dataset.isSafety === 'true';
                const cardIndex = approveRadio ? approveRadio.dataset.itemIndex : null;
                const warningBox = cardIndex !== null ? document.getElementById('security-warning-' + cardIndex) : null;
                const securityCheckbox = warningBox ? warningBox.querySelector('.security-checkbox') : null;

                // 1. Debe haber seleccionado una opción
                if (!approveRadio.checked && !rejectRadio.checked) {
                    hasErrors = true;
                    card.classList.add('border-danger', 'bg-light-danger');
                    if (!firstErrorEl) firstErrorEl = card;
                } else {
                    card.classList.remove('border-danger', 'bg-light-danger');
                }

                // 2. Si rechazó un ítem de seguridad, debe confirmar expresamente
                if (rejectRadio.checked && isSafety) {
                    if (securityCheckbox && !securityCheckbox.checked) {
                        hasErrors = true;
                        warningBox.classList.add('border-3', 'shadow-sm');
                        if (!firstErrorEl) firstErrorEl = warningBox;
                    }
                }
            });

            if (hasErrors) {
                e.preventDefault();
                alert('Por favor selecciona una decisión (Aprobar o Rechazar) para cada ítem. Si rechazas un trabajo de seguridad, debes marcar la confirmación requerida.');
                if (firstErrorEl) {
                    firstErrorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        // Inicializar cálculos al cargar la página
        updateCalculations();
    });
    </script>
}
